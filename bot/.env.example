# Official bot token from https://discord.com/developers/applications -> Bot.
# Never use a Discord user account token or share tokens in chat.
DISCORD_TOKEN=
# Application (client) ID from the General Information page
DISCORD_CLIENT_ID=
# Optional: register commands to one server for instant updates while testing.
# Leave empty to register globally (can take up to an hour to appear).
DISCORD_GUILD_ID=
# Optional: path to the games config (defaults to bot/games.json).
# The bot needs write permission here to save calibrated menu steps.
JACKBOX_CONFIG=

# Linux VPS: public MediaMTX WebRTC reader with game video AND audio.
# The installer sets this in jackbox-bot.service.
# STREAM_PUBLIC_URL=http://YOUR_SERVER_IP:8889/game
# Public URL of the browser control server. Setting this enables the server.
# Use HTTPS for both control and stream URLs on a public deployment.
# CONTROL_PUBLIC_URL=http://YOUR_SERVER_IP:3000
# CONTROL_HOST=0.0.0.0
# CONTROL_PORT=3000

# Optional stream overrides (defaults shown).
# STREAM_PUBLISH_URL=rtsp://127.0.0.1:8554/game
# STREAM_AUDIO_SOURCE=game.monitor
# STREAM_SIZE=1280x720
# STREAM_FPS=30
# STREAM_BITRATE=2500k
# STREAM_CODEC=h264
