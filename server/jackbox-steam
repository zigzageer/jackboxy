#!/usr/bin/env bash
# Downloads the Jackbox packs you own from your Steam account into
# /opt/jackbox/games with SteamCMD (Windows builds, run under Wine).
# Run with sudo; it asks for your Steam login and Steam Guard code.
#
#   sudo jackbox-steam            # packs 1, 3, 4, 5, 6, 7, 8
#   sudo jackbox-steam 3 7        # only some packs
set -euo pipefail

APP_USER=jackbox
GAMES_DIR=/opt/jackbox/games
declare -A APP_IDS=([1]=331670 [2]=397460 [3]=434170 [4]=610180 [5]=774461 [6]=1005300 [7]=1211630 [8]=1552350 [9]=1850960 [10]=2216870)

if [[ $EUID -ne 0 ]]; then echo "Run this with sudo." >&2; exit 1; fi
packs=("$@")
[[ ${#packs[@]} -gt 0 ]] || packs=(1 3 4 5 6 7 8)

if ! command -v steamcmd >/dev/null && [[ ! -x /usr/games/steamcmd ]]; then
  echo "Installing SteamCMD"
  add-apt-repository -y multiverse >/dev/null
  dpkg --add-architecture i386
  apt-get update -q
  echo steam steam/question select "I AGREE" | debconf-set-selections
  echo steam steam/license note '' | debconf-set-selections
  DEBIAN_FRONTEND=noninteractive apt-get install -y -q steamcmd
fi
STEAMCMD=$(command -v steamcmd || echo /usr/games/steamcmd)

read -rp "Steam username: " steam_user </dev/tty

install -d -o $APP_USER -g $APP_USER $GAMES_DIR
# One SteamCMD run per pack: install dirs must be set before login. The first run
# asks for your password and Steam Guard code; later runs reuse the saved login.
for p in "${packs[@]}"; do
  id=${APP_IDS[$p]:-}
  if [[ -z $id ]]; then echo "Unknown pack $p, skipping." >&2; continue; fi
  echo "==> Pack $p (Steam app $id)"
  sudo -u $APP_USER -H "$STEAMCMD" +@sSteamCmdForcePlatformType windows \
    +force_install_dir "$GAMES_DIR/The Jackbox Party Pack $p" \
    +login "$steam_user" +app_update "$id" validate +quit </dev/tty
done

echo
echo "Done. Installed packs are in $GAMES_DIR."
