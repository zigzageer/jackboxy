#!/usr/bin/env bash
# Asks for the Discord bot details, saves them, registers the slash commands
# and (re)starts the bot. Run with sudo after install.sh.
set -euo pipefail

APP_USER=jackbox
BOT_DIR=/opt/jackbox/repo/bot
ENV_FILE=$BOT_DIR/.env

if [[ $EUID -ne 0 ]]; then echo "Run this with sudo." >&2; exit 1; fi

echo "Find these at https://discord.com/developers/applications"
read -rsp "Bot token (hidden): " token </dev/tty; echo
read -rp "Application ID: " client_id </dev/tty
read -rp "Server ID to register commands in (recommended, Enter to skip): " guild_id </dev/tty

umask 077
temporary_env=$(mktemp "$BOT_DIR/.env.XXXXXX")
trap 'rm -f "$temporary_env"' EXIT
# Keep non-Discord local settings such as JACKBOX_CONFIG.
if [[ -f $ENV_FILE ]]; then
  awk '!/^DISCORD_(TOKEN|CLIENT_ID|GUILD_ID)=/' "$ENV_FILE" > "$temporary_env"
fi
cat >> "$temporary_env" <<EOF

DISCORD_TOKEN=$token
DISCORD_CLIENT_ID=$client_id
DISCORD_GUILD_ID=$guild_id
EOF
install -o $APP_USER -g $APP_USER -m 0600 "$temporary_env" "$ENV_FILE"

sudo -u $APP_USER bash -c "cd $BOT_DIR && node src/register-commands.js"
systemctl enable jackbox-bot >/dev/null
systemctl restart jackbox-bot
sleep 3
systemctl --no-pager --lines=5 status jackbox-bot || true
echo
echo "Bot started. Logs: sudo journalctl -u jackbox-bot -f"
